# ==============================================================================
# GEMINI AI INTEGRATION
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# GOOGLE DRIVE INTEGRATION
# ==============================================================================
# Google Drive Folder IDs (Folder containing data: portfolio.json, portfolio_targets.json, etf_cache.json)
GDRIVE_DATA_FOLDER_ID=1FrsIRkosCKqtZ5qm7cIRttYP_fdQpfWD
# Google Drive Folder ID for SQLite snapshots (finances.db)
GDRIVE_SNAPSHOTS_FOLDER_ID=1SaP9Tklp2BJRBeKnWpaUo1eLl9ekcKmj
# Google Drive Folder ID for XTB broker screenshots (optional)
GDRIVE_XTB_OPEN_POSITIONS_FOLDER_ID=

# OAuth2 Credentials Paths (defaults shown relative to repository root)
GDRIVE_CREDENTIALS_FILE=secrets/credentials.json
GDRIVE_TOKEN_FILE=secrets/token.json
GDRIVE_CREDENTIALS_PATH=secrets/credentials.json
GDRIVE_TOKEN_PATH=secrets/token.json

# ==============================================================================
# RCLONE REMOTE CONFIGURATION (OPTIONAL / ALTERNATIVE SYNC)
# ==============================================================================
RCLONE_REMOTE_NAME=gdrive
RCLONE_REMOTE_DATA_PATH=finances/data
RCLONE_REMOTE_SNAPSHOTS_PATH=finances/snapshots

# ==============================================================================
# ETF CACHE CONFIGURATION
# ==============================================================================
ETF_CACHE_TTL_DAYS=30
STOCK_CACHE_TTL_DAYS=7

# ==============================================================================
# LOOK-THROUGH EXPOSURE POLICY LIMITS
# ==============================================================================
MAX_COUNTRY_ALLOCATION_PCT=60.0
MAX_TECH_ALLOCATION_PCT=50.0
MAX_OTHER_SECTOR_ALLOCATION_PCT=15.0
MAX_COMPANY_ALLOCATION_PCT=15.0

# ==============================================================================
# EXPOSURE PENALTY CONFIGURATION
# ==============================================================================
EXPOSURE_SECTOR_PENALTY_WEIGHT=0.30
EXPOSURE_COUNTRY_PENALTY_WEIGHT=0.20

# ==============================================================================
# DATABASE CONFIGURATION & SNAPSHOT RULES
# ==============================================================================
FINANCE_DB_FILE=data/finances.db
SNAPSHOT_FRESHNESS_HOURS=48

# ==============================================================================
# PROJECTIONS DATA
# ==============================================================================
MONTHLY_CONTRIBUTION=300.0
INFLATION_RATE=0.02

# ==============================================================================
# INFRASTRUCTURE & NOTIFICATIONS (OPTIONAL)
