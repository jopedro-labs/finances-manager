from collections.abc import Sequence

from _typeshed import Incomplete
from google.auth import credentials as credentials
from google.auth import exceptions as exceptions
from google.auth.transport.requests import Request
from google.oauth2 import reauth as reauth

class Credentials(credentials.ReadOnlyScoped, credentials.CredentialsWithQuotaProject):
    token: Incomplete
    expiry: Incomplete
    def __init__(
        self,
        token: str | None,
        refresh_token: str | None = ...,
        id_token: str | None = ...,
        token_uri: str | None = ...,
        client_id: str | None = ...,
        client_secret: str | None = ...,
        scopes: Sequence[str] | None = ...,
        default_scopes: Sequence[str] | None = ...,
        quota_project_id: str | None = ...,
        expiry: Incomplete | None = ...,
        rapt_token: str | None = ...,
        refresh_handler: Incomplete | None = ...,
        enable_reauth_refresh: bool = ...,
    ) -> None: ...
    @property
    def refresh_token(self) -> str | None: ...
    @property
    def scopes(self) -> frozenset[str] | None: ...
    @property
    def token_uri(self) -> str | None: ...
    @property
    def id_token(self) -> str | None: ...
    @property
    def client_id(self) -> str | None: ...
    @property
    def client_secret(self) -> str | None: ...
    @property
    def requires_scopes(self) -> bool: ...
    @property
    def rapt_token(self) -> str | None: ...
    @property
    def refresh_handler(self) -> Incomplete: ...
    @refresh_handler.setter
    def refresh_handler(self, value: Incomplete) -> None: ...
    def with_quota_project(self, quota_project_id: str) -> Credentials: ...
    def refresh(self, request: Request) -> None: ...
    @classmethod
    def from_authorized_user_info(
        cls, info: dict[str, str], scopes: Sequence[str] | None = ...
    ) -> Credentials: ...
    @classmethod
    def from_authorized_user_file(
        cls, filename: str, scopes: Sequence[str] | None = ...
    ) -> Credentials: ...
    def to_json(self, strip: Sequence[str] | None = ...) -> str: ...

class UserAccessTokenCredentials(credentials.CredentialsWithQuotaProject):
    def __init__(
        self,
        account: str | None = ...,
        quota_project_id: str | None = ...,
    ) -> None: ...
    def with_account(self, account: str) -> UserAccessTokenCredentials: ...
    def with_quota_project(self, quota_project_id: str) -> UserAccessTokenCredentials: ...
    token: Incomplete
    def refresh(self, request: Request) -> None: ...
    def before_request(
        self, request: Request, method: str, url: str, headers: dict[str, str]
    ) -> None: ...
